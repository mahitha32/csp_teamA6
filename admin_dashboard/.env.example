# Admin Dashboard Environment Configuration
# Development default (direct API endpoint):
VITE_API_URL=http://localhost:5000/api

# Production configuration:
# For reverse-proxy setups (Nginx / single-domain hosting):
# VITE_API_URL=/api
#
# For cloud hosted frontends (e.g., Vercel / Netlify with cloud backend):
# VITE_API_URL=https://<your-backend-domain>.onrender.com/api
