# ============================================================
# .env.example — Copy to .env and fill in your values
# Village Complaint Redressal System - Vemavaram Village
# ============================================================

# Flask
FLASK_ENV=development
SECRET_KEY=vemavaram-csp-secret-key-change-in-production-2026
JWT_SECRET_KEY=vemavaram-jwt-secret-change-in-production-2026
JWT_ACCESS_TOKEN_EXPIRES=86400      # 24 hours in seconds
JWT_REFRESH_TOKEN_EXPIRES=2592000   # 30 days in seconds

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vemavaram_csp
DB_USER=root
DB_PASSWORD=your_mysql_password
# DB_SSL_MODE=REQUIRED           # Optional: For cloud MySQL requiring SSL (e.g., Aiven, PlanetScale, TiDB)
# DB_SSL_CA=/path/to/ca.pem      # Optional: CA certificate path if required by cloud MySQL

# Cloudinary Image Storage (for complaint & resolution photos)
# Option A: 3 separate keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Option B: Single URL (auto-parsed if provided)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Firebase Auth (optional, for Flutter phone authentication verification)
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}  # Optional: Inline JSON string for cloud deployment

# OTP Settings (mock by default, set USE_REAL_OTP=true for production)
USE_REAL_OTP=false
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# SMS Gateway (MSG91 — replace with your provider)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_template_id
MSG91_SENDER_ID=VEMVLG

# Default Admin Credentials for initial setup (Change immediately after first login!)
DEFAULT_ADMIN_EMAIL=admin@vemavaram.gov.in
DEFAULT_ADMIN_PASSWORD=your_secure_admin_password

# CORS — Whitelist allowed frontend origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5500,https://complaintredressalsystem.vercel.app
