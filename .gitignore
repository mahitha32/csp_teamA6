# ============================================================
# .gitignore — Vemavaram Village Complaint Redressal System (CSP)
# ============================================================

# Environment variables & local credentials (NEVER commit real secrets!)
.env
.env.*
!.env.example
*.local

# Secrets & Private Keys
firebase_credentials.json
*credential*.json
google-services.json
*.pem
*.key

# Backups
_backups/
*.bak
*.backup
*.tmp

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend artifacts (Admin Dashboard)
node_modules/
admin_dashboard/dist/
admin_dashboard/dist-ssr/
.pnp
.pnp.js

# Flutter & Mobile artifacts
mobile_app/.dart_tool/
mobile_app/.flutter-plugins
mobile_app/.flutter-plugins-dependencies
mobile_app/.packages
mobile_app/build/
*.apk
*.aab
*.ipa
*.app

# Local user-uploaded media (keep directory structure with .gitkeep)
backend/app/static/uploads/complaints/*
!backend/app/static/uploads/complaints/.gitkeep
backend/app/static/uploads/resolutions/*
!backend/app/static/uploads/resolutions/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
